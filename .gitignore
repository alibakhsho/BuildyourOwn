node_modules/
dist/
.env
.env.*
!.env.example
!server/.env.example
.DS_Store
*.log

# Accounting OAuth tokens (Xero/MYOB refresh tokens — never commit these)
server/.tokens.json

# Admin panel — a static design mockup whose charts are randomly generated
# (ri(40,180)), with no auth and no data source. Kept out of git so a stray
# `git add .` can't publish a login-less dashboard of invented numbers to the
# deployed site. Delete this line once it reads real data behind real auth.
admin-panel/

# Mobile build config holds only the public backend URL (see the file).
!.env.mobile

# Raw Higgsfield API outputs (scripts/higgsfield-api.mjs) — review, then copy
# the keepers into public/ deliberately
generated/

# Brand assets: commit the briefs, state and full-res JPEG finals (brandkit/finals);
# keep the 4K PNG originals, raw downloads and video drafts local only.
brandkit/**/*.png
!brandkit/logo-v2/**/*.png
brandkit/**/*.mp4
brandkit/**/*.log
brandkit/**/contact.jpg
