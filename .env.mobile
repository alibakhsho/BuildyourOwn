# Loaded by `vite build --mode mobile` (npm run build:mobile). The native app
# serves its own copy of dist/ from inside the phone, so relative /api calls
# have nowhere to go — they must name the deployed backend explicitly.
# Public values only: this file is committed. Supabase keys still come from
# .env.local, which every mode loads.
VITE_AI_BACKEND=https://buildyourown.dev
