# Copy this file to server/.env and fill it in. server/.env is gitignored.

# ---------------------------------------------------------------------------
# AI  (required for the AI crew and the plan reader)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides:
# PORT=8787
# BYO_AI_MODEL=claude-opus-5


# ---------------------------------------------------------------------------
# URLs  (needed once you connect an accounting package)
#   BYO_PUBLIC_URL — where this backend is reachable from the internet. It is
#     what OAuth redirect URIs are built from, so it must match the redirect
#     URI registered in the Xero/MYOB developer portal EXACTLY.
#     Local dev: use a tunnel (ngrok/cloudflared) — neither provider will
#     redirect to a bare localhost URL over plain http.
#   BYO_APP_URL — where the frontend lives, for the "back to app" link.
# ---------------------------------------------------------------------------
# BYO_PUBLIC_URL=https://your-tunnel.ngrok.app
# BYO_APP_URL=http://localhost:5173


# ---------------------------------------------------------------------------
# Xero   developer.xero.com/app/manage
#   Redirect URI to register:  <BYO_PUBLIC_URL>/api/accounting/xero/callback
#   XERO_SCOPES: apps created on/after 2 March 2026 use Xero's granular
#   scopes. Paste the exact scope string shown on your app's page rather than
#   relying on the default below, which is the older broad-scope set.
# ---------------------------------------------------------------------------
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_SCOPES=openid profile email offline_access accounting.transactions accounting.contacts accounting.settings
# XERO_SALES_ACCOUNT_CODE=200
# XERO_COGS_ACCOUNT_CODE=300
# XERO_SALES_TAX_TYPE=OUTPUT
# XERO_PURCHASE_TAX_TYPE=INPUT
# XERO_PAYMENT_TERMS_DAYS=14


# ---------------------------------------------------------------------------
# MYOB   my.myob.com.au → Developer → Register app
#   Redirect URL to register:  <BYO_PUBLIC_URL>/api/accounting/myob/callback
#   MYOB_SCOPES: the legacy CompanyFile scope was deprecated on 1 Sep 2026.
#   Paste the exact scope string your app was registered with.
#   MYOB_CF_USERNAME / _PASSWORD: only for AccountRight company files secured
#   with a file-level user login. Leave unset for cloud files.
#   The account numbers are required before a push will succeed — they are the
#   accounts claims and purchase orders post against in your chart.
# ---------------------------------------------------------------------------
# MYOB_CLIENT_ID=
# MYOB_CLIENT_SECRET=
# MYOB_SCOPES=offline_access
# MYOB_INCOME_ACCOUNT=4-1000
# MYOB_COS_ACCOUNT=5-1000
# MYOB_SALES_TAX_CODE=GST
# MYOB_PURCHASE_TAX_CODE=GST
# MYOB_CF_USERNAME=
# MYOB_CF_PASSWORD=
