# Copy to .env.local (gitignored) and fill in from your Supabase project:
#   Dashboard -> Project Settings -> API
#
# Only the PUBLISHABLE key belongs here. Anything prefixed VITE_ is compiled
# into the JavaScript bundle and is visible to every visitor, so the
# service-role / secret key must never be given a VITE_ name — it goes in
# server/.env instead, where only the backend can read it.
#
# Leaving these unset is fine: the app detects that auth is unconfigured and
# runs exactly as it does today, on localStorage, with no sign-in offered.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: point the frontend at a deployed AI backend instead of the local
# Vite proxy. Leave unset for local dev.
# VITE_AI_BACKEND=https://your-backend.example.com
